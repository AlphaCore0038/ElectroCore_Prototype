generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Merchant {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String
  email       String
  phone       String?
  address     String?
  currency    String    @default("INR")
  logoUrl     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
  orders      Order[]
}

enum ProductCategory {
  AUDIO
  PERIPHERALS
  POWER
  CABLES
  STORAGE
  ACCESSORIES
}

enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

model Product {
  id          String          @id @default(cuid())
  merchantId  String
  merchant    Merchant        @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  slug        String          @unique
  sku         String          @unique
  name        String
  description String
  category    ProductCategory
  price       Int
  currency    String          @default("INR")
  stock       Int             @default(0)
  status      ProductStatus   @default(ACTIVE)
  imageUrl    String?
  attributes  Json?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  intents     PurchaseIntent[]
  orderItems  OrderItem[]

  @@index([merchantId, category, status])
  @@index([name])
}

enum IntentStatus {
  PENDING
  CONSUMED
  EXPIRED
  REJECTED
}

enum OrderStatus {
  PAID
  FAILED
  REFUNDED
}

enum PaymentStatus {
  CREATED
  VERIFIED
  FAILED
}

model PurchaseIntent {
  id        String       @id @default(cuid())
  productId String
  product   Product      @relation(fields: [productId], references: [id])
  quantity  Int          @default(1)
  unitPrice Int
  total     Int
  currency  String       @default("INR")
  status    IntentStatus @default(PENDING)
  expiresAt DateTime
  createdAt DateTime     @default(now())
  orders    Order[]
  payments  Payment[]
  audits    AuditEvent[]

  @@index([productId, status])
  @@index([status, expiresAt])
}

model Order {
  id             String      @id @default(cuid())
  intentId       String      @unique
  intent         PurchaseIntent @relation(fields: [intentId], references: [id])
  merchantId     String
  merchant       Merchant    @relation(fields: [merchantId], references: [id])
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  total          Int
  currency       String      @default("INR")
  status         OrderStatus @default(PAID)
  createdAt      DateTime    @default(now())
  items          OrderItem[]
  payment        Payment?
  audits         AuditEvent[]

  @@index([merchantId])
  @@index([conversationId])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  slug      String
  name      String
  sku       String
  unitPrice Int
  quantity  Int
  total     Int

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String?       @unique
  order             Order?        @relation(fields: [orderId], references: [id])
  intentId          String        @unique
  intent            PurchaseIntent @relation(fields: [intentId], references: [id])
  razorpayOrderId   String        @unique
  razorpayPaymentId String?       @unique
  razorpaySignature String?
  amount            Int
  currency          String        @default("INR")
  status            PaymentStatus @default(CREATED)
  createdAt         DateTime      @default(now())
  verifiedAt        DateTime?
  audits            AuditEvent[]

  @@index([intentId])
  @@index([razorpayOrderId])
}

model AuditEvent {
  id        String   @id @default(cuid())
  intentId  String?
  intent    PurchaseIntent? @relation(fields: [intentId], references: [id])
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id])
  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id])
  type      String
  reason    String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([intentId])
  @@index([orderId])
  @@index([type, createdAt])
}

model Conversation {
  id        String    @id @default(cuid())
  title     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]
  orders    Order[]

  @@index([createdAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}
